#: .\apps\web\forms.py
msgid "Numéro invalide : 8 chiffres d'un mobile haïtien, avec ou sans +509."
msgstr ""
"Invalid number: 8 digits of a Haitian mobile number, with or without +509."

#: .\apps\web\forms.py
msgid ""
"Ce numéro ne peut pas recevoir d'argent : MonCash et NatCash fonctionnent "
"uniquement sur des lignes mobiles."
msgstr ""
"This number cannot receive money: MonCash and NatCash only work on mobile "
"lines."

#: .\apps\web\forms.py
msgid "Votre numéro de téléphone"
msgstr "Your phone number"

#: .\apps\web\forms.py
msgid "Code reçu par SMS"
msgstr "Code received by SMS"

#: .\apps\web\forms.py
msgid "Saisissez les chiffres du code reçu par SMS."
msgstr "Enter the digits of the code you received by SMS."

#: .\apps\web\forms.py .\apps\web\templates\web\account_password.html
msgid "Mot de passe"
msgstr "Password"

#: .\apps\web\forms.py
msgid "Mot de passe actuel"
msgstr "Current password"

#: .\apps\web\forms.py .\apps\web\templates\web\password_reset.html
msgid "Nouveau mot de passe"
msgstr "New password"

#: .\apps\web\forms.py
msgid "Que s'est-il passé ?"
msgstr "What happened?"

#: .\apps\web\forms.py
msgid "Expliquez en quelques mots"
msgstr "Tell us in a few words"

#: .\apps\web\forms.py
msgid "Ajouter un message"
msgstr "Add a message"

#: .\apps\web\forms.py
msgid "Retapez le numéro du bénéficiaire"
msgstr "Retype the recipient's number"

#: .\apps\web\forms.py
msgid "Recevoir les avis de ce transfert par"
msgstr "Receive notices about this transfer by"

#: .\apps\web\forms.py
msgid ""
"En choisissant WhatsApp, vous acceptez d'y recevoir les avis de vos "
"transferts. Si le message ne peut pas vous être livré, il vous est envoyé "
"par SMS."
msgstr ""
"By choosing WhatsApp, you agree to receive notices about your transfers "
"there. If the message cannot be delivered to you, it is sent to you by SMS."

#: .\apps\web\forms.py
msgid ""
"Les deux numéros ne correspondent pas. Retapez-le, ou modifiez l'envoi si le "
"premier était faux."
msgstr ""
"The two numbers do not match. Retype it, or edit the transfer if the first "
"one was wrong."

#: .\apps\web\forms.py
msgid "J'envoie depuis"
msgstr "I'm sending from"

#: .\apps\web\forms.py
msgid "Le bénéficiaire reçoit sur"
msgstr "The recipient receives on"

#: .\apps\web\forms.py
msgid "Numéro du bénéficiaire"
msgstr "Recipient's number"

#: .\apps\web\forms.py
msgid "Montant reçu par le bénéficiaire (HTG)"
msgstr "Amount the recipient receives (HTG)"

#: .\apps\web\forms.py
msgid "Choisissez un portefeuille différent de celui d'envoi."
msgstr "Choose a different wallet from the one you're sending from."

#: .\apps\web\labels.py
msgid "Carte bancaire"
msgstr "Bank card"

#: .\apps\web\labels.py
msgid "En attente de paiement"
msgstr "Awaiting payment"

#: .\apps\web\labels.py
msgid "En cours"
msgstr "In progress"

#: .\apps\web\labels.py
msgid "Livré"
msgstr "Delivered"

#: .\apps\web\labels.py
msgid "Expiré"
msgstr "Expired"

#: .\apps\web\labels.py
msgid "Remboursé"
msgstr "Refunded"

#: .\apps\web\labels.py
msgid "Annulé"
msgstr "Cancelled"

#: .\apps\web\templates\web\account_password.html
#: .\apps\web\templates\web\transfers.html
msgid "Changer de mot de passe"
msgstr "Change password"

#: .\apps\web\templates\web\account_password.html
msgid "Vos autres connexions seront fermées. Celle-ci reste ouverte."
msgstr "Your other sessions will be signed out. This one stays open."

#: .\apps\web\templates\web\account_password.html
#: .\apps\web\templates\web\transfers.html
msgid "Créer un mot de passe"
msgstr "Create a password"

#: .\apps\web\templates\web\account_password.html
msgid ""
"Avec un mot de passe, vous vous connectez tout de suite, sans attendre de "
"code par SMS. Le code reste possible à tout moment."
msgstr ""
"With a password, you sign in right away, without waiting for an SMS code. "
"You can still use a code at any time."

#: .\apps\web\templates\web\account_password.html
#: .\apps\web\templates\web\password_reset.html
#, python-format
msgid "Au moins %(count)s caractères, dont au moins une lettre."
msgstr "At least %(count)s characters, including at least one letter."

#: .\apps\web\templates\web\account_password.html
msgid "Enregistrer"
msgstr "Save"

#: .\apps\web\templates\web\account_password.html
#: .\apps\web\templates\web\transfers.html
msgid "Plus tard"
msgstr "Later"

#: .\apps\web\templates\web\base.html .\apps\web\templates\web\transfers.html
msgid "Mes transferts"
msgstr "My transfers"

#: .\apps\web\templates\web\base.html
msgid "Déconnexion"
msgstr "Log out"

#: .\apps\web\templates\web\base.html .\apps\web\templates\web\login.html
#: .\apps\web\templates\web\login_code.html
msgid "Se connecter"
msgstr "Log in"

#: .\apps\web\templates\web\base.html
msgid "Un portefeuille vers l'autre. Simplement."
msgstr "From one wallet to another. Simply."

#: .\apps\web\templates\web\base.html
msgid "Langue"
msgstr "Language"

#: .\apps\web\templates\web\base.html
msgid "OK"
msgstr "OK"

#: .\apps\web\templates\web\claim_open.html
msgid "Signaler un problème"
msgstr "Report a problem"

#: .\apps\web\templates\web\claim_open.html
#: .\apps\web\templates\web\partials\transfer_status.html
msgid "Transfert"
msgstr "Transfer"

#: .\apps\web\templates\web\claim_open.html
msgid "Envoyer ma réclamation"
msgstr "Send my claim"

#: .\apps\web\templates\web\claim_open.html
msgid ""
"Nous vous répondons sur la page de ce transfert. Vous recevrez un SMS quand "
"la réponse sera prête."
msgstr ""
"We answer on this transfer's page. You will get a text message when the "
"answer is ready."

#: .\apps\web\templates\web\claim_open.html
msgid "Retour au transfert"
msgstr "Back to the transfer"

#: .\apps\web\templates\web\confirm.html
msgid "Vérifiez votre envoi"
msgstr "Check your transfer"

#: .\apps\web\templates\web\confirm.html
#: .\apps\web\templates\web\transfer_detail.html
#, python-format
msgid "Vers le %(wallet)s du <strong class=\"mono\">%(phone)s</strong>"
msgstr "To the %(wallet)s account <strong class=\"mono\">%(phone)s</strong>"

#: .\apps\web\templates\web\confirm.html
#, python-format
msgid "Payé avec %(wallet)s"
msgstr "Paid with %(wallet)s"

#: .\apps\web\templates\web\confirm.html
#, python-format
msgid "Payer %(total)s HTG"
msgstr "Pay %(total)s HTG"

#: .\apps\web\templates\web\confirm.html
msgid "Modifier l'envoi"
msgstr "Edit transfer"

#: .\apps\web\templates\web\home.html
msgid "Envoyer de l'argent d'un portefeuille à l'autre"
msgstr "Send money from one wallet to another"

#: .\apps\web\templates\web\home.html
msgid ""
"Le bénéficiaire reçoit exactement le montant annoncé. Les frais sont "
"affichés avant de payer."
msgstr ""
"The recipient receives exactly the amount shown. Fees are displayed before "
"you pay."

#: .\apps\web\templates\web\home.html
msgid "Fonctionne avec"
msgstr "Works with"

#: .\apps\web\templates\web\home.html
msgid "payer et recevoir"
msgstr "pay and receive"

#: .\apps\web\templates\web\home.html
msgid "payer seulement"
msgstr "pay only"

#: .\apps\web\templates\web\home.html
msgid "recevoir seulement"
msgstr "receive only"

#: .\apps\web\templates\web\home.html
msgid "Le service est momentanément indisponible. Réessayez plus tard."
msgstr "The service is temporarily unavailable. Please try again later."

#: .\apps\web\templates\web\home.html
msgid "Continuer"
msgstr "Continue"

#: .\apps\web\templates\web\home.html
#, python-format
msgid "Montant minimum : %(amount)s HTG."
msgstr "Minimum amount: %(amount)s HTG."

#: .\apps\web\templates\web\home.html
msgid "Exemple"
msgstr "Example"

#: .\apps\web\templates\web\home.html
#, python-format
msgid "%(amount)s HTG reçus sur %(destination)s, payés avec %(source)s"
msgstr "%(amount)s HTG received on %(destination)s, paid with %(source)s"

#: .\apps\web\templates\web\home.html
msgid "à payer"
msgstr "to pay"

#: .\apps\web\templates\web\home.html
#, python-format
msgid "%(amount)s HTG reçus + %(fees)s HTG de frais"
msgstr "%(amount)s HTG received + %(fees)s HTG in fees"

#: .\apps\web\templates\web\home.html
msgid "Ce qu'on vous garantit"
msgstr "What we guarantee"

#: .\apps\web\templates\web\home.html
msgid "Le montant exact"
msgstr "The exact amount"

#: .\apps\web\templates\web\home.html
msgid "La personne reçoit ce qui est annoncé, pas une gourde de moins."
msgstr "The recipient gets what was announced, not one gourde less."

#: .\apps\web\templates\web\home.html
msgid "Frais avant de payer"
msgstr "Fees before you pay"

#: .\apps\web\templates\web\home.html
msgid "Le total est affiché avant toute validation."
msgstr "The total is shown before you confirm anything."

#: .\apps\web\templates\web\home.html
msgid "Suivi et SMS"
msgstr "Tracking and SMS"

#: .\apps\web\templates\web\home.html
msgid "Le suivi se met à jour seul, et un SMS confirme l'arrivée."
msgstr "Tracking updates on its own, and an SMS confirms arrival."

#: .\apps\web\templates\web\home.html
msgid "Remboursé si ça échoue"
msgstr "Refunded if it fails"

#: .\apps\web\templates\web\home.html
msgid "Et pour toute question, une réclamation avec la référence du transfert."
msgstr "For any question, open a claim with the transfer reference."

#: .\apps\web\templates\web\home.html
msgid "Questions fréquentes"
msgstr "Frequently asked questions"

#: .\apps\web\templates\web\home.html
msgid "Combien puis-je envoyer ?"
msgstr "How much can I send?"

#: .\apps\web\templates\web\home.html
#, python-format
msgid ""
"De %(min)s HTG à %(max)s HTG par transfert. Des plafonds par jour "
"s'appliquent aussi : le site vous prévient s'il faut attendre."
msgstr "From %(min)s HTG to %(max)s HTG per transfer. Daily limits also apply: the site tells you if you need to wait."

#: .\apps\web\templates\web\home.html
msgid "Et si je me trompe de numéro ?"
msgstr "What if I enter the wrong number?"

#: .\apps\web\templates\web\home.html
msgid ""
"Avant de payer, on vous demande de retaper le numéro : deux saisies "
"différentes bloquent l'envoi. Si l'argent est déjà parti, ouvrez une "
"réclamation avec la référence du transfert."
msgstr "Before you pay, you are asked to type the number again: two different entries block the transfer. If the money has already gone, open a claim with the transfer reference."

#: .\apps\web\templates\web\home.html
msgid "Que se passe-t-il si le transfert échoue ?"
msgstr "What happens if the transfer fails?"

#: .\apps\web\templates\web\home.html
msgid ""
"Notre équipe rend l'argent sur le portefeuille qui a payé, et vous recevez "
"un SMS."
msgstr "Our team returns the money to the wallet that paid, and you receive an SMS."

#: .\apps\web\templates\web\home.html
msgid "Comment suivre mon transfert ?"
msgstr "How do I track my transfer?"

#: .\apps\web\templates\web\home.html
msgid ""
"Après le paiement, la page du transfert se met à jour toute seule. Vous la "
"retrouvez dans « Mes transferts »."
msgstr "After payment, the transfer page updates on its own. You can find it under “My transfers”."

#: .\apps\web\templates\web\login.html .\apps\web\templates\web\login_code.html
msgid "Connexion"
msgstr "Log in"

#: .\apps\web\templates\web\login.html
msgid ""
"Recevez un code par SMS, ou utilisez votre mot de passe si vous en avez créé "
"un."
msgstr "Get a code by SMS, or use your password if you have created one."

#: .\apps\web\templates\web\login.html
msgid "Avec un code SMS"
msgstr "With an SMS code"

#: .\apps\web\templates\web\login.html
#: .\apps\web\templates\web\password_forgot.html
msgid "Recevoir un code"
msgstr "Get a code"

#: .\apps\web\templates\web\login.html
msgid "ou"
msgstr "or"

#: .\apps\web\templates\web\login.html
msgid "Avec mon mot de passe"
msgstr "With my password"

#: .\apps\web\templates\web\login.html
msgid "Mot de passe oublié ?"
msgstr "Forgot your password?"

#: .\apps\web\templates\web\login.html
msgid ""
"Pas encore de compte ? Recevez un code : votre compte est créé dès que votre "
"numéro est vérifié."
msgstr "No account yet? Get a code: your account is created as soon as your number is verified."

#: .\apps\web\templates\web\login_code.html
msgid "Saisissez le code"
msgstr "Enter the code"

#: .\apps\web\templates\web\login_code.html
#: .\apps\web\templates\web\password_reset.html
#, python-format
msgid "Code envoyé par SMS au <strong class=\"mono\">+%(phone)s</strong>."
msgstr "Code sent by SMS to <strong class=\"mono\">+%(phone)s</strong>."

#: .\apps\web\templates\web\login_code.html
msgid "Changer de numéro ou recevoir un nouveau code"
msgstr "Change number or get a new code"

#: .\apps\web\templates\web\partials\fees.html
msgid "Le bénéficiaire reçoit"
msgstr "Recipient receives"

#: .\apps\web\templates\web\partials\fees.html
#, python-format
msgid "Frais %(wallet)s"
msgstr "%(wallet)s fee"

#: .\apps\web\templates\web\partials\fees.html
msgid "Frais Plip-Plip"
msgstr "Plip-Plip fee"

#: .\apps\web\templates\web\partials\fees.html
msgid "Total à payer"
msgstr "Total to pay"

#: .\apps\web\templates\web\partials\fees.html
msgid ""
"Par carte, le paiement est débité en dollars américains, après conversion "
"par notre prestataire de paiement."
msgstr ""
"Card payments are charged in US dollars, converted by our payment provider."

#: .\apps\web\templates\web\partials\how_it_works.html
msgid "Comment ça marche"
msgstr "How it works"

#: .\apps\web\templates\web\partials\how_it_works.html
msgid "Numéro et montant"
msgstr "Number and amount"

#: .\apps\web\templates\web\partials\how_it_works.html
msgid ""
"Choisissez les portefeuilles, tapez le numéro et ce que la personne doit "
"recevoir. Les frais s'affichent tout de suite."
msgstr "Choose the wallets, type the number and what the person should receive. The fees show up right away."

#: .\apps\web\templates\web\partials\how_it_works.html
msgid "Vous payez"
msgstr "You pay"

#: .\apps\web\templates\web\partials\how_it_works.html
msgid ""
"La page de votre portefeuille s'ouvre. Vous validez le paiement chez lui, "
"comme d'habitude."
msgstr "Your wallet's page opens. You approve the payment there, as usual."

#: .\apps\web\templates\web\partials\how_it_works.html
msgid "L'argent arrive"
msgstr "The money arrives"

#: .\apps\web\templates\web\partials\how_it_works.html
msgid ""
"La personne reçoit le montant exact sur son portefeuille. Vous suivez le "
"transfert en direct et recevez un SMS."
msgstr "The person receives the exact amount in their wallet. You follow the transfer live and receive an SMS."

#: .\apps\web\templates\web\partials\password_field.html
msgid "Afficher"
msgstr "Show"

#: .\apps\web\templates\web\partials\password_field.html
msgid "Masquer"
msgstr "Hide"

#: .\apps\web\templates\web\partials\quote.html
msgid "Saisissez un montant pour voir les frais et le total."
msgstr "Enter an amount to see the fees and the total."

#: .\apps\web\templates\web\partials\transfer_status.html
msgid "Paiement"
msgstr "Payment"

#: .\apps\web\templates\web\partials\transfer_status.html
msgid "Reçu"
msgstr "Received"

#: .\apps\web\templates\web\partials\transfer_status.html
msgid ""
"Payez pour lancer le transfert. La page de paiement s'ouvre dans un nouvel "
"onglet ; revenez ici ensuite, cette page se met à jour toute seule."
msgstr ""
"Pay to start the transfer. The payment page opens in a new tab; come back "
"here afterwards, this page updates by itself."

#: .\apps\web\templates\web\partials\transfer_status.html
msgid "Payer maintenant"
msgstr "Pay now"

#: .\apps\web\templates\web\partials\transfer_status.html
msgid ""
"Une demande de paiement a été envoyée sur votre téléphone MonCash. Validez-"
"la pour lancer le transfert."
msgstr ""
"A payment request was sent to your MonCash phone. Approve it to start the "
"transfer."

#: .\apps\web\templates\web\partials\transfer_status.html
msgid ""
"Le lien de paiement n'a pas pu être obtenu. Ne relancez pas de nouveau "
"transfert tout de suite : si une demande de paiement vous parvient, vous "
"pouvez la valider, cette page le détectera."
msgstr ""
"We couldn't get the payment link. Don't start a new transfer right away: if "
"a payment request reaches you, you can approve it and this page will detect "
"it."

#: .\apps\web\templates\web\partials\transfer_status.html
#, python-format
msgid "À payer avant %(time)s."
msgstr "Pay before %(time)s."

#: .\apps\web\templates\web\partials\transfer_status.html
msgid "Paiement reçu. Le transfert vers le bénéficiaire est en cours."
msgstr "Payment received. The transfer to the recipient is under way."

#: .\apps\web\templates\web\partials\transfer_status.html
#, python-format
msgid ""
"Le bénéficiaire devrait recevoir l'argent dans moins de %(max)s minutes."
msgstr "The recipient should receive the money in less than %(max)s minutes."

#: .\apps\web\templates\web\partials\transfer_status.html
#, python-format
msgid ""
"Le bénéficiaire devrait recevoir l'argent dans environ %(min)s à %(max)s "
"minutes."
msgstr ""
"The recipient should receive the money in about %(min)s to %(max)s minutes."

#: .\apps\web\templates\web\partials\transfer_status.html
msgid "Il sera traité dès que possible."
msgstr "It will be processed as soon as possible."

#: .\apps\web\templates\web\partials\transfer_status.html
msgid "Inutile de refaire l'envoi : cette page se met à jour toute seule."
msgstr "No need to send again: this page updates by itself."

#: .\apps\web\templates\web\partials\transfer_status.html
#, python-format
msgid "Le bénéficiaire a reçu %(amount)s HTG."
msgstr "The recipient received %(amount)s HTG."

#: .\apps\web\templates\web\partials\transfer_status.html
msgid "Aucun paiement n'a été reçu à temps. Rien n'a été débité."
msgstr "No payment was received in time. Nothing was charged."

#: .\apps\web\templates\web\partials\transfer_status.html
#: .\apps\web\templates\web\transfers.html
msgid "Nouvel envoi"
msgstr "New transfer"

#: .\apps\web\templates\web\partials\transfer_status.html
msgid "Ce transfert a été remboursé."
msgstr "This transfer was refunded."

#: .\apps\web\templates\web\partials\transfer_status.html
msgid "Ce transfert a été annulé. Aucun montant n'a été débité."
msgstr "This transfer was cancelled. Nothing was charged."

#: .\apps\web\templates\web\password_forgot.html
msgid "Mot de passe oublié"
msgstr "Forgot password"

#: .\apps\web\templates\web\password_forgot.html
msgid ""
"Nous envoyons un code par SMS à votre numéro. Il vous permettra de choisir "
"un nouveau mot de passe."
msgstr ""
"We will send a code by SMS to your number. It lets you choose a new password."

#: .\apps\web\templates\web\password_forgot.html
msgid "Retour à la connexion"
msgstr "Back to sign in"

#: .\apps\web\templates\web\password_reset.html
msgid "Toutes vos autres connexions seront fermées."
msgstr "All your other sessions will be signed out."

#: .\apps\web\templates\web\password_reset.html
msgid "Enregistrer et me connecter"
msgstr "Save and sign in"

#: .\apps\web\templates\web\password_reset.html
msgid "Recevoir un nouveau code"
msgstr "Get a new code"

#: .\apps\web\templates\web\transfer_detail.html
msgid "Référence du transfert"
msgstr "Transfer reference"

#: .\apps\web\templates\web\transfer_detail.html
msgid "Gardez cette référence : elle vous sera demandée en cas de réclamation."
msgstr "Keep this reference: you'll be asked for it if you make a claim."

#: .\apps\web\templates\web\transfer_detail.html
#: .\apps\web\templates\web\transfers.html
msgid "Refaire cet envoi"
msgstr "Send again"

#: .\apps\web\templates\web\transfer_detail.html
msgid "Votre réclamation"
msgstr "Your claim"

#: .\apps\web\templates\web\transfer_detail.html
msgid "Vous"
msgstr "You"

#: .\apps\web\templates\web\transfer_detail.html
msgid "Envoyer"
msgstr "Send"

#: .\apps\web\templates\web\transfer_detail.html
msgid "Un problème avec ce transfert ?"
msgstr "A problem with this transfer?"

#: .\apps\web\templates\web\transfer_detail.html
msgid "Tous mes transferts"
msgstr "All my transfers"

#: .\apps\web\templates\web\transfers.html
msgid "Connecté avec le <span class=\"mono\">%(phone)s</span>"
msgstr "Signed in as <span class=\"mono\">%(phone)s</span>"

#: .\apps\web\templates\web\transfers.html
msgid "en cours"
msgstr "in progress"

#: .\apps\web\templates\web\transfers.html
msgid "livrés"
msgstr "delivered"

#: .\apps\web\templates\web\transfers.html
msgid "HTG reçus par vos proches"
msgstr "HTG received by your loved ones"

#: .\apps\web\templates\web\transfers.html
msgid "Connectez-vous sans attendre de code."
msgstr "Sign in without waiting for a code."

#: .\apps\web\templates\web\transfers.html
msgid "Créez un mot de passe : la prochaine fois, vous entrerez tout de suite."
msgstr "Create a password: next time, you will get in right away."

#: .\apps\web\templates\web\transfers.html
msgid "Réponse à lire"
msgstr "Answer to read"

#: .\apps\web\templates\web\transfers.html
msgid "Plus récents"
msgstr "Newer"

#: .\apps\web\templates\web\transfers.html
msgid "Plus anciens"
msgstr "Older"

#: .\apps\web\templates\web\transfers.html
msgid "Vous n'avez encore envoyé aucun transfert."
msgstr "You haven't sent any transfers yet."

#: .\apps\web\templates\web\transfers.html
msgid "Faire un envoi"
msgstr "Send money"

#: .\apps\web\views.py
msgid ""
"Ce moyen de paiement est momentanément indisponible. Choisissez-en un autre."
msgstr "This payment method is temporarily unavailable. Please choose another."

#: .\apps\web\views.py
#, python-format
msgid "Le montant minimum est de %(amount)s HTG."
msgstr "The minimum amount is %(amount)s HTG."

#: .\apps\web\views.py
#, python-format
msgid "Le montant maximum est de %(amount)s HTG."
msgstr "The maximum amount is %(amount)s HTG."

#: .\apps\web\views.py
msgid "Cette combinaison de portefeuilles n'est pas proposée."
msgstr "This combination of wallets isn't available."

#: .\apps\web\views.py
msgid ""
"Les transferts sont momentanément suspendus. Rien n'a été débité. Réessayez "
"plus tard."
msgstr ""
"Transfers are temporarily suspended. Nothing was charged. Please try again "
"later."

#: .\apps\web\views.py
msgid ""
"Nous recevons beaucoup de transferts en ce moment. Plutôt que de prendre "
"votre argent sans pouvoir le livrer rapidement, nous préférons attendre. "
"Réessayez dans quelques minutes."
msgstr ""
"We're receiving a lot of transfers right now. Rather than take your money "
"without being able to deliver it quickly, we prefer to wait. Please try "
"again in a few minutes."

#: .\apps\web\views.py
msgid ""
"Ce numéro ne peut pas recevoir ce montant pour le moment. Réessayez plus "
"tard."
msgstr "This number cannot receive this amount right now. Try again later."

#: .\apps\web\views.py
#, python-format
msgid ""
"Ce montant depasse a lui seul votre plafond de %(cap)s HTG. Envoyez un "
"montant plus petit."
msgstr ""
"This amount alone is above your %(cap)s HTG limit. Send a smaller amount."

#: .\apps\web\views.py
#, python-format
msgid "Vous pourrez envoyer a nouveau a partir de %(hour)s:00."
msgstr "You can send again from %(hour)s:00."

#: .\apps\web\views.py
#, python-format
msgid "Vous pourrez envoyer a nouveau demain a partir de %(hour)s:00."
msgstr "You can send again tomorrow from %(hour)s:00."

#: .\apps\web\views.py
#, python-format
msgid "Vous pourrez envoyer a nouveau a partir du %(date)s a %(hour)s:00."
msgstr "You can send again from %(date)s at %(hour)s:00."

#: .\apps\web\views.py
#, python-format
msgid "Vous avez atteint votre plafond de %(cap)s HTG par jour."
msgstr "You have reached your daily limit of %(cap)s HTG."

#: .\apps\web\views.py
#, python-format
msgid "Vous avez atteint votre plafond de %(cap)s HTG sur 30 jours."
msgstr "You have reached your 30-day limit of %(cap)s HTG."

#: .\apps\web\views.py
msgid "Trop de demandes. Patientez une minute."
msgstr "Too many requests. Please wait a minute."

#: .\apps\web\views.py
msgid "Cette confirmation a expiré. Vérifiez à nouveau votre envoi."
msgstr "This confirmation has expired. Please check your transfer again."

#: .\apps\web\views.py
msgid "Trop de transferts en peu de temps. Réessayez plus tard."
msgstr "Too many transfers in a short time. Please try again later."

#: .\apps\web\views.py
msgid ""
"Les frais ont changé depuis votre saisie. Vérifiez le nouveau total avant de "
"confirmer."
msgstr ""
"The fees have changed since you started. Check the new total before "
"confirming."

#: .\apps\web\views.py
msgid "Cette demande est déjà en cours de traitement."
msgstr "This request is already being processed."

#: .\apps\web\views.py
msgid ""
"Le paiement n'a pas pu être créé. Aucun montant n'a été débité. Vous pouvez "
"réessayer."
msgstr ""
"The payment couldn't be created. Nothing was charged. You can try again."

#: .\apps\web\views.py
msgid "Trop de réclamations en peu de temps. Réessayez plus tard."
msgstr "Too many claims in a short time. Try again later."

#: .\apps\web\views.py
msgid ""
"Votre réclamation est enregistrée. Nous vous répondons sur cette page, et "
"par SMS."
msgstr "Your claim is recorded. We answer on this page, and by text message."

#: .\apps\web\views.py
msgid "Trop de messages en peu de temps. Réessayez plus tard."
msgstr "Too many messages in a short time. Try again later."

#: .\apps\web\views.py
msgid "Message ajouté à votre réclamation."
msgstr "Message added to your claim."

#: .\apps\web\views.py
msgid "Trop de demandes de code pour ce numéro. Patientez avant de réessayer."
msgstr ""
"Too many code requests for this number. Please wait before trying again."

#: .\apps\web\views.py
msgid "Ce numéro ne peut pas recevoir de SMS."
msgstr "This number can't receive SMS."

#: .\apps\web\views.py
msgid ""
"L'envoi du SMS est momentanément impossible. Réessayez dans quelques minutes."
msgstr "We can't send the SMS right now. Please try again in a few minutes."

#: .\apps\web\views.py
msgid "Trop de tentatives. Demandez un nouveau code plus tard."
msgstr "Too many attempts. Request a new code later."

#: .\apps\web\views.py
msgid "Code invalide ou expiré."
msgstr "Invalid or expired code."

#: .\apps\web\views.py
msgid "Ce compte est désactivé. Contactez le support."
msgstr "This account is disabled. Please contact support."

#: .\apps\web\views.py
msgid "Trop de tentatives. Demandez un nouveau code."
msgstr "Too many attempts. Request a new code."

#: .\apps\web\views.py
msgid ""
"La vérification est momentanément impossible. Réessayez dans quelques "
"minutes."
msgstr ""
"Verification isn't possible right now. Please try again in a few minutes."

#: .\apps\web\views.py
msgid "Numéro ou mot de passe incorrect."
msgstr "Incorrect number or password."

#: .\apps\web\views.py
#, python-format
msgid "Au moins %(count)s caractères."
msgstr "At least %(count)s characters."

#: .\apps\web\views.py
#, python-format
msgid "%(count)s caractères au maximum."
msgstr "%(count)s characters at most."

#: .\apps\web\views.py
msgid ""
"Ajoutez au moins une lettre : un mot de passe fait uniquement de chiffres "
"est refusé."
msgstr ""
"Add at least one letter: a password made only of digits is not accepted."

#: .\apps\web\views.py
msgid "Ce mot de passe est trop courant. Choisissez-en un autre."
msgstr "This password is too common. Choose another one."

#: .\apps\web\views.py
msgid "Ce mot de passe ressemble trop à votre numéro de téléphone."
msgstr "This password is too similar to your phone number."

#: .\apps\web\views.py
msgid "Mot de passe enregistré. Vous êtes connecté."
msgstr "Password saved. You are signed in."

#: .\apps\web\views.py
msgid "Mot de passe actuel incorrect."
msgstr "Current password is incorrect."

#: .\apps\web\views.py
msgid ""
"Mot de passe enregistré. La prochaine fois, connectez-vous sans attendre de "
"code."
msgstr "Password saved. Next time, sign in without waiting for a code."