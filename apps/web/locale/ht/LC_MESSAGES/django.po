msgid ""
"Nous vous répondons sur la page de ce transfert. Vous recevrez un SMS quand "
"la réponse sera prête."
msgstr "N ap reponn ou sou paj transfè sa a. W ap resevwa yon SMS lè repons lan pare."

#: .\apps\web\templates\web\claim_open.html
msgid "Retour au transfert"
msgstr "Retounen nan transfe a"

#: .\apps\web\templates\web\confirm.html
msgid "Vérifiez votre envoi"
msgstr "Verifye transfè w la"

#: .\apps\web\templates\web\confirm.html
