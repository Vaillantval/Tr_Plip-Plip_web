#: .\apps\web\views.py
msgid "Ce compte est désactivé. Contactez le support."
msgstr "Kont sa a dezaktive. Kontakte sipò a."

#: .\apps\web\views.py
msgid "Trop de tentatives. Demandez un nouveau code."
msgstr "Twòp tantativ. Mande yon nouvo kòd."

#: .\apps\web\views.py
msgid ""
"La vérification est momentanément impossible. Réessayez dans quelques "
"minutes."
msgstr "Nou pa ka fè verifikasyon an kounye a. Eseye ankò nan kèk minit."

#: .\apps\web\views.py
msgid "Numéro ou mot de passe incorrect."
msgstr "Nimewo a oswa modpas la pa bon."

#: .\apps\web\views.py
#, python-format
msgid "Au moins %(count)s caractères."
msgstr "Omwen %(count)s karaktè."

#: .\apps\web\views.py
#, python-format
msgid "%(count)s caractères au maximum."
msgstr "%(count)s karaktè pou pi plis."

