#: .\apps\notifications\messages.py
#, python-format
msgid ""
"Plip-Plip : %(amount)s HTG ont ete envoyes au %(phone)s. Reference "
"%(reference)s."
msgstr "Plip-Plip: %(amount)s HTG sent to %(phone)s. Reference %(reference)s."

#: .\apps\notifications\messages.py
#, python-format
msgid ""
"Plip-Plip : votre transfert %(reference)s a ete rembourse. %(amount)s HTG "
"vous ont ete rendus."
msgstr ""
"Plip-Plip: your transfer %(reference)s was refunded. %(amount)s HTG returned "
"to you."
