DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Superadmin cree ou mis a jour a chaque deploiement (manage.py predeploy).
# Mot de passe vide : rien n'est fait. Minimum 12 caracteres, non courant.
# Les variables font foi : un mot de passe change dans la console est
# remplace au deploiement suivant.
SUPERADMIN_USERNAME=info@plip.ht
SUPERADMIN_EMAIL=info@plip.ht
SUPERADMIN_PASSWORD=

# En production (Railway), DATABASE_URL remplace les variables DB_*.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_SSL_REQUIRE=0
DB_NAME=plipplip
DB_USER=plipplip
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Ne jamais commiter ces deux valeurs. Le secret fait 64 caracteres.
PLOPPLOP_BASE_URL=https://plopplop.solutionip.app
PLOPPLOP_CLIENT_ID=
PLOPPLOP_CLIENT_SECRET=
PLOPPLOP_TIMEOUT=30

PAYOUT_COOLDOWN_SECONDS=125
PAYOUT_MAX_ATTEMPTS=3
PAYMENT_EXPIRY_SECONDS=1800
PAYOUT_PENDING_STALE_SECONDS=7200
PAYOUT_VERIFY_GRACE_SECONDS=600
PAYOUT_DRAIN_INTERVAL_SECONDS=30
PAYOUT_STALL_SECONDS=375
PAYOUT_INFLIGHT_STALE_SECONDS=600
ETA_MAX_DISPLAY_SECONDS=3600
# PAYOUT_LOCK_TTL_SECONDS : par defaut 6 x PLOPPLOP_TIMEOUT + 60

# API publique. OTP_BACKEND=console en dev (code dans les logs) ; la prod
# impose twilio. Ne jamais commiter le jeton Twilio.
OTP_BACKEND=console
OTP_CODE_TTL_SECONDS=600
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Expediteur des SMS de notification (l'un des deux suffit).
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_TIMEOUT=10
API_TOKEN_TTL_SECONDS=2592000
NOTIFICATIONS_MAX_ATTEMPTS=5
NOTIFICATIONS_MAX_AGE_SECONDS=3600
API_NUM_PROXIES=0
API_DOCS_ENABLED=1

# Frais client, couts plopplop et commission : console, ecran « Methodes et tarifs ».
MAX_NET_AMOUNT=50000
# Longueur des fenetres de plafond ; les MONTANTS se reglent dans la console.
LIMIT_DAY_SECONDS=86400
LIMIT_MONTH_SECONDS=2592000

FLOAT_WARNING=50000
FLOAT_CRITICAL=20000
