DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# En production (Railway), DATABASE_URL remplace les variables DB_*.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_SSL_REQUIRE=0
DB_NAME=plipplip
DB_USER=plipplip
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Ne jamais commiter ces deux valeurs. Le secret fait 64 caracteres.
PLOPPLOP_BASE_URL=https://plopplop.solutionip.app
PLOPPLOP_CLIENT_ID=
PLOPPLOP_CLIENT_SECRET=
PLOPPLOP_TIMEOUT=30

PAYOUT_COOLDOWN_SECONDS=125
PAYOUT_MAX_ATTEMPTS=3
PAYMENT_EXPIRY_SECONDS=1800
PAYOUT_PENDING_STALE_SECONDS=7200
PAYOUT_VERIFY_GRACE_SECONDS=600

# API publique. OTP_BACKEND=console en dev (code dans les logs) ; la prod
# impose twilio. Ne jamais commiter le jeton Twilio.
OTP_BACKEND=console
OTP_CODE_TTL_SECONDS=600
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_TIMEOUT=10
API_TOKEN_TTL_SECONDS=2592000
API_NUM_PROXIES=0
API_DOCS_ENABLED=1

# Frais client, couts plopplop et commission : console, ecran « Methodes et tarifs ».
MAX_NET_AMOUNT=50000

FLOAT_WARNING=50000
FLOAT_CRITICAL=20000
